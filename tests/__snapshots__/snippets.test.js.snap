exports[`multipart body > csharp: file part and field part 1`] = `
"using System;
using System.IO;
using System.Net.Http;

var client = new HttpClient();
var request = new HttpRequestMessage(HttpMethod.Post, "https://api.example.com/fr/api/library/documents");
request.Headers.Add("api_key", "sk-123");

var form = new MultipartFormDataContent();
form.Add(new StreamContent(File.OpenRead("cni.jpg")), "file", "cni.jpg");
form.Add(new StringContent("IDENTITE"), "categorie");
request.Content = form;

var response = await client.SendAsync(request);
Console.WriteLine(await response.Content.ReadAsStringAsync());"
`;

