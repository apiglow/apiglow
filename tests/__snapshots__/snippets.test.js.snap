"package main

import (
	"fmt"
	"io"
	"net/http"
	"os"
)

func main() {
	payload, _ := os.Open("cat.png")
	defer payload.Close()

	req, _ := http.NewRequest("POST", "https://api.example.com/v1/pet/42/uploadImage", payload)
	req.Header.Set("Content-Type", "application/octet-stream")
	res, _ := http.DefaultClient.Do(req)
	defer res.Body.Close()
	body, _ := io.ReadAll(res.Body)
	fmt.Println(string(body))
}"
`;

