exports[`multipart body > go: file part and field part 1`] = `
"package main

import (
	"bytes"
	"fmt"
	"io"
	"mime/multipart"
	"net/http"
	"os"
)

func main() {
	var buf bytes.Buffer
	w := multipart.NewWriter(&buf)
	file, _ := os.Open("cni.jpg")
	part, _ := w.CreateFormFile("file", "cni.jpg")
	io.Copy(part, file)
	file.Close()
	w.WriteField("categorie", "IDENTITE")
	w.Close()

	req, _ := http.NewRequest("POST", "https://api.example.com/fr/api/library/documents", &buf)
	req.Header.Set("Content-Type", w.FormDataContentType())
	req.Header.Set("api_key", "sk-123")
	res, _ := http.DefaultClient.Do(req)
	defer res.Body.Close()
	body, _ := io.ReadAll(res.Body)
	fmt.Println(string(body))
}"
`;

