exports[`snippet ruby > GET redacted by default 1`] = `
"require 'net/http'
require 'uri'

uri = URI("https://api.example.com/v1/pet/42?verbose=true")
request = Net::HTTP::Get.new(uri)
request["api_key"] = "••••"
request["Accept"] = "application/json"

response = Net::HTTP.start(uri.hostname, uri.port, use_ssl: uri.scheme == 'https') do |http|
  http.request(request)
end

puts response.body"
`;

