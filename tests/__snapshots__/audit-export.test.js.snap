{
  "format": "apiglow-audit-report",
  "passed": true,
  "rules": {
    "duplicate-operation-id": {
      "category": "correctness",
      "fix": "Rename one of the operationIds so that each value is unique in the document — a verb and a noun reads best (listPets, getPet).",
      "label": "Duplicate operationId",
      "message": "operationId “{operationId}” is used by more than one operation.",
      "why": "An operationId must be unique in the document, and this documentation turns it into the operation's deep link: one of the two links lands on the other operation.",
    },
    "operation-tagged": {
      "category": "readiness",
      "fix": "Add at least one tag, and declare it with a description in the top-level tags list.",
      "label": "Operation without tag",
      "message": "This operation carries no tag.",
      "why": "It lands in the navigation's catch-all group along with every other untagged operation, and the reader cannot tell which family it belongs to.",
    },
    "security-scheme-described": {
      "category": "readiness",
      "fix": "Add a description to the scheme saying where to get the credential and in what form to paste it.",
      "label": "Security scheme without description",
      "message": "Security scheme “{name}” has no description.",
      "why": "The credentials block shows that description to explain what to paste and where to get it. Without one, the reader faces a bare field labelled with the scheme's key.",
    },
  },
