</head>
<body>
<main>
<p class="snapshot-open"><a href="https://docs.example.com/api/index.html#/op/listPets">Open in the interactive documentation</a></p>
<article>
<h1>List pets</h1>
<p>Returns every pet, <code>{{petId}}</code> included.</p>
<pre><code class="language-http">GET https://api.example.com/pets
</code></pre>
<table>
<thead>
<tr>
<th>Name</th>
<th>Type</th>
</tr>
</thead>
<tbody><tr>
<td>id</td>
<td>int</td>
</tr>
</tbody></table>
</article>
</main>
</body>
</html>
"
