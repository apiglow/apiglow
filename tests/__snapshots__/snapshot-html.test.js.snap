// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`baked HTML snapshot > wraps the mirror in the head a crawler reads 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
