{
  "swagger": "2.0",
  "info": {
    "title": "Petstore 2.0",
    "version": "1.0.0",
    "description": "Fixture exercising the whole Swagger 2.0 conversion table: host/basePath/schemes, consumes/produces, body and formData parameters, every collectionFormat, moved components, securityDefinitions, string discriminator.",
    "termsOfService": "https://example.com/terms",
    "contact": { "name": "API team", "email": "api@example.com" },
    "license": { "name": "MIT", "url": "https://opensource.org/licenses/MIT" }
  },
  "host": "api.example.com",
  "basePath": "/v2/",
  "schemes": ["https", "http", "wss"],
  "consumes": ["application/json"],
  "produces": ["application/json", "application/xml"],
  "externalDocs": { "description": "Find out more", "url": "https://example.com/docs" },
  "tags": [{ "name": "pets", "description": "Everything about pets" }],
  "security": [{ "petstore_auth": ["read:pets"] }],
  "x-vendor-note": { "kept": true },
  "paths": {
    "/pets": {
      "parameters": [
        {
          "name": "X-Trace",
          "in": "header",
          "description": "Shared by every operation of this path",
          "type": "string"
        }
      ],
      "get": {
        "operationId": "listPets",
        "tags": ["pets"],
        "summary": "List pets",
        "description": "Returns **all pets**.",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Statuses to filter by",
            "required": true,
            "type": "array",
            "items": { "type": "string", "enum": ["available", "pending", "sold"] },
            "collectionFormat": "multi"
          },
          {
            "name": "tags",
            "in": "query",
            "description": "Default collection format",
            "type": "array",
            "items": { "type": "string" }
          },
          {
            "name": "ids",
            "in": "query",
            "type": "array",
            "items": { "type": "integer", "format": "int64" },
            "collectionFormat": "pipes"
          },
          {
            "name": "sort",
            "in": "query",
            "type": "array",
            "items": { "type": "string" },
            "collectionFormat": "ssv"
          },
          {
            "name": "fields",
            "in": "query",
            "type": "array",
            "items": { "type": "string" },
            "collectionFormat": "tsv"
          },
          {
            "name": "X-Regions",
            "in": "header",
            "type": "array",
            "items": { "type": "string" },
            "collectionFormat": "ssv"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size",
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100,
            "exclusiveMaximum": true,
            "default": 20,
            "allowEmptyValue": true
          }
        ],
        "responses": {
          "200": {
            "description": "A paged array of pets",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/Pet" } },
            "headers": {
              "X-Next": { "description": "Next page token", "type": "string" },
              "X-Pages": { "type": "array", "items": { "type": "integer" }, "collectionFormat": "ssv" }
            },
            "examples": { "application/json": [{ "id": 1, "name": "Rex" }] }
          },
          "default": { "$ref": "#/responses/Unexpected" }
        }
      },
      "post": {
        "operationId": "addPet",
        "tags": ["pets"],
        "summary": "Create a pet",
        "consumes": ["application/json", "application/xml"],
        "schemes": ["https"],
        "parameters": [{ "$ref": "#/parameters/PetBody" }],
        "responses": {
          "201": { "description": "Created", "schema": { "$ref": "#/definitions/Pet" } },
          "405": { "description": "Invalid input" }
        },
        "security": [{ "petstore_auth": ["write:pets"] }]
      }
    },
    "/pets/{petId}": {
      "parameters": [
        {
          "name": "petId",
          "in": "path",
          "description": "ID of the pet",
          "required": true,
          "type": "integer",
          "format": "int64"
        }
      ],
      "get": {
        "operationId": "getPet",
        "tags": ["pets"],
        "summary": "Get a pet by id",
        "responses": {
          "200": { "description": "OK", "schema": { "$ref": "#/definitions/Pet" } },
          "404": { "description": "Not found" }
        }
      },
      "post": {
        "operationId": "uploadPetImage",
        "tags": ["pets"],
        "summary": "Upload an image",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "name": "metadata",
            "in": "formData",
            "description": "Additional data to pass to the server",
            "type": "string"
          },
          { "name": "file", "in": "formData", "description": "The file to upload", "type": "file", "required": true },
          {
            "name": "labels",
            "in": "formData",
            "type": "array",
            "items": { "type": "string" },
            "collectionFormat": "multi"
          }
        ],
        "responses": { "200": { "description": "Uploaded", "schema": { "$ref": "#/definitions/ApiResponse" } } }
      },
      "delete": {
        "operationId": "deletePet",
        "tags": ["pets"],
        "summary": "Delete a pet",
        "responses": { "204": { "description": "Deleted" } },
        "security": []
      }
    },
    "/pets/{petId}/form": {
      "post": {
        "operationId": "updatePetWithForm",
        "tags": ["pets"],
        "summary": "Update a pet with form data",
        "consumes": ["application/x-www-form-urlencoded"],
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "type": "integer", "format": "int64" },
          { "name": "name", "in": "formData", "description": "Updated name", "type": "string", "required": true },
          { "name": "status", "in": "formData", "description": "Updated status", "type": "string" }
        ],
        "responses": { "200": { "description": "Updated" } }
      }
    },
    "/pets/{petId}/photo": {
      "get": {
        "operationId": "getPetPhoto",
        "tags": ["pets"],
        "summary": "Download the pet photo",
        "produces": ["image/png"],
        "parameters": [{ "name": "petId", "in": "path", "required": true, "type": "integer", "format": "int64" }],
        "responses": { "200": { "description": "The photo", "schema": { "type": "file" } } }
      }
    }
  },
  "parameters": {
    "PetBody": {
      "name": "body",
      "in": "body",
      "description": "Pet to add to the store",
      "required": true,
      "schema": { "$ref": "#/definitions/NewPet" }
    },
    "ApiKeyHeader": { "name": "X-Api-Version", "in": "header", "type": "string", "enum": ["1", "2"] }
  },
  "responses": {
    "Unexpected": {
      "description": "Unexpected error",
      "schema": { "$ref": "#/definitions/Error" }
    }
  },
  "securityDefinitions": {
    "basic_auth": { "type": "basic", "description": "HTTP basic" },
    "api_key": { "type": "apiKey", "name": "api_key", "in": "header" },
    "petstore_auth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://example.com/oauth/authorize",
      "tokenUrl": "https://example.com/oauth/token",
      "scopes": { "read:pets": "read your pets", "write:pets": "modify pets in your account" }
    },
    "implicit_auth": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://example.com/oauth/authorize",
      "scopes": { "read:pets": "read your pets" }
    },
    "app_auth": {
      "type": "oauth2",
      "flow": "application",
      "tokenUrl": "https://example.com/oauth/token",
      "scopes": {}
    }
  },
  "definitions": {
    "Pet": {
      "type": "object",
      "discriminator": "petType",
      "required": ["id", "name", "petType"],
      "properties": {
        "id": { "type": "integer", "format": "int64", "readOnly": true },
        "name": { "type": "string", "minLength": 1 },
        "petType": { "type": "string" },
        "tag": { "type": "string", "x-nullable": true },
        "status": { "type": "string", "enum": ["available", "pending", "sold"] }
      },
      "example": { "id": 1, "name": "Rex", "petType": "Dog" }
    },
    "Dog": {
      "allOf": [
        { "$ref": "#/definitions/Pet" },
        { "type": "object", "required": ["packSize"], "properties": { "packSize": { "type": "integer" } } }
      ]
    },
    "Cat": {
      "allOf": [
        { "$ref": "#/definitions/Pet" },
        { "type": "object", "properties": { "indoor": { "type": "boolean" } } }
      ]
    },
    "NewPet": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ApiResponse": {
      "type": "object",
      "properties": { "code": { "type": "integer", "format": "int32" }, "message": { "type": "string" } }
    },
    "Error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": { "code": { "type": "integer" }, "message": { "type": "string" } }
    }
  }
}
